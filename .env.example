# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Email (Resend): the link that confirms a new account, and password resets.
# Without a key, the dev server prints each email to the terminal instead.
RESEND_API_KEY=""
# The sender, on a domain verified in Resend, e.g. "Book Builder <hello@yourdomain.com>".
# Left empty it's onboarding@resend.dev, which only delivers to your own Resend address.
EMAIL_FROM=""

# Pictures on the art shelf (Vercel Blob, a public store): the read-write token Vercel adds when
# the store is connected to the project with "Add a read-write token env var" ticked.
# Without it, the dev server keeps pictures in a folder on this computer instead (ART_STORE_DIR,
# or book-builder-art in the system's temp folder), and a deployed site can't take uploads.
BLOB_READ_WRITE_TOKEN=""
ART_STORE_DIR=""
